#!/usr/bin/env bash
# ai - launcher for locally installed AI coding CLIs.

set -u
shopt -s extglob

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  printf 'ai: bash 4 or newer is required (this shell is %s).\n' "${BASH_VERSION:-unknown}" >&2
  exit 1
fi

VERSION="0.4"
NONINTERACTIVE=0
SAVED_TTY=""
CONFIG="${AI_CONFIG:-$HOME/.config/ai/tools.conf}"
BIN_DIR="${AI_BIN_DIR:-$HOME/.local/bin}"

# Curated registry: Label|command|launch args|install hint.
# npm package names were verified against the npm registry on 2026-10-28;
# the rest come from each vendor's own install docs. This list only supplies
# friendly labels and hints - discovery below finds tools that are not listed.
CANDIDATES=(
  "Qoder|qoder||"
  "OpenCode|opencode||npm:opencode-ai"
  "Claude Code|claude||npm:@anthropic-ai/claude-code"
  "Codex|codex||npm:@openai/codex"
  "Gemini CLI|gemini||npm:@google/gemini-cli"
  "Copilot CLI|copilot||npm:@github/copilot"
  "Cursor Agent|cursor-agent||"
  "Amp|amp||npm:@sourcegraph/amp"
  "Droid|droid||npm:@factory/cli"
  "Kiro|kiro-cli||"
  "Augment|augment||"
  "Goose|goose||"
  "Crush|crush||"
  "Aider|aider||pipx:aider-chat"
  "Kilo|kilo||npm:@kilocode/cli"
  "Cline|clite||npm:@cline/cli"
  "OpenHands|openhands||"
  "Continue|cn||npm:@continuedev/cli"
  "Qwen Code|qwen||npm:@qwen-code/qwen-code"
  "Kimi Code|kimi||npm:@moonshot-ai/kimi-code"
  "iFlow|iflow||npm:@iflow-ai/iflow-cli"
  "Codebuff|codebuff||npm:codebuff"
  "Freebuff|freebuff||npm:freebuff"
)

# Name fragments that mark a binary as an AI coding agent during discovery.
# A token must sit on a separator or the end of a name, so `buffer` and
# `sample` are safe but `free-claude-code` and `codebuff` both match.
# Extend without editing the script: AI_AGENT_TOKENS='claude|mytool'
AGENT_TOKENS="${AI_AGENT_TOKENS:-claude|codex|gemini|opencode|crush|goose|aider|droid|copilot|kilocode|kilo|clite|qwen|kimi|iflow|openhands|kiro|augment|qoder|aichat|chatblade|mipilot|chacha|grok|mycoder|llm|sgpt|tgpt|amp|buff}"
# Bare "<name>-agent" is only accepted with an AI-ish root, otherwise ssh-agent
# and friends show up as coding tools.
AGENT_ROOT='ai|cli|open|super|my|dev|code|cod|llm|gpt|copilot|agent'
AGENT_RE="(^(cli-|ai-)?(${AGENT_TOKENS})([-_.].*)?\$)|(^|[-_.])(${AGENT_TOKENS})([-_.]|\$)|^(${AGENT_ROOT})([-_].*)?[-_]agent\$"
# Discovery matches these but they are editors, wrappers or unrelated tools.
DENY_RE='^(ai|code|codium|cursor)$|\.(exe|dll|bak|old|orig|py[co]|zip|zst|appimage)$|[-_](setup|install|templates|proxy|router|bridge|server|daemon|doctor|login|auth|token|key|completion|helper|shim|wrapper|test)$'
# System daemons that end in "-agent" and are not AI tools.
SYSTEM_AGENT_RE='(^|[-_])(ssh|gpg|pgp|pinentry|pam|polkit|systemd|tty|dbus|udev|udisks|upower|network|consolekit|keyring|secret|secrets|avahi|bluetooth|cups|mail|clamav|antivirus|fail2ban|password|user|session|log|logging|metric|metrics|stats|watchdog|update|packagekit|apparmor|audit|git|svn|docker|containerd|kube|bus|socket|net|fs|gc|cc|term|x11|wayland)-agent$'

# Vendor install dirs searched even when missing from PATH.
EXTRA_DIRS=(
  "$HOME/.local/bin"
  "$HOME/.bun/bin"
  "$HOME/.cargo/bin"
  "$HOME/go/bin"
  "$HOME/.npm-global/bin"
  "$HOME/.deno/bin"
  "$HOME/.opencode/bin"
  "$HOME/.qoder/entry"
  "/usr/local/bin"
  "/opt/homebrew/bin"
  "$HOME/.linuxbrew/bin"
)

usage() {
  cat <<USAGE
ai $VERSION - launcher for local AI coding CLIs

  ai                      pick a tool with the arrow keys, enter to launch
  ai <tool> [args...]     launch by command or label name, args pass through
  ai -l                   list detected tools (tab separated: command, label)
  ai -a | --all           registry + discovered tools, found and missing
  ai --missing            registry entries not installed yet
  ai doctor               dependency, discovery, registry and trust check
  install [--copy]        link this script into $BIN_DIR (override: AI_BIN_DIR)
  uninstall               remove that link, only if it points back here
  help | --version        this message, or the version

Detection:
  Scans every PATH entry plus a few vendor install dirs and matches agent-name
  patterns, so locally installed tools are found without registering them.
  PATH dirs under /mnt are skipped so Windows shares do not slow the scan.
  AI_DISCOVER=0        skip discovery, use the registry only
  AI_EXTRA_DIRS="a:b"  more dirs to scan
  AI_AGENT_TOKENS      extend the name patterns that count as an agent

Environment:
  AI_CONFIG, AI_BIN_DIR override the config file and the install target.
  AI_TRUST_INSECURE=1  allow launching a tool whose file or directory is
                       writable by another account (refused by default).

Config ($CONFIG, one entry per line):
  Label|command|args      add your own agent; command may be an absolute path
  !command                hide a tool discovery keeps finding
  # comment               must start the line (paths may contain #)

Keys: up/down or j/k move, 1-9 jumps, g/G first/last, home/end, enter launches, q quits.

Quick start:
  chmod +x ai
  ./ai install          # then run "ai" anywhere
USAGE
}

check_deps() {
  # Only the interactive picker needs stty; subcommands like install, doctor and
  # the plain listings must still work in a container without it.
  if [ "${1:-}" = menu ] && ! command -v stty >/dev/null 2>&1; then
    printf 'ai: "stty" is required for arrow-key navigation and was not found.\n' >&2
    printf '   use "ai <tool>" to launch directly, or AI_DISCOVER=0 ai -l to list\n' >&2
    exit 1
  fi
  [ "${1:-}" = verbose ] || return 0
  local note=()
  command -v stty >/dev/null 2>&1 || note+=("stty missing: arrow keys unavailable, use \"ai <tool>\"")
  command -v tput >/dev/null 2>&1 || note+=("tput missing: terminal size falls back to 80x24")
  command -v stat >/dev/null 2>&1 || note+=("stat missing: launch-time permission check disabled")
  printf 'bash     %s\n' "$BASH_VERSION"
  printf 'stty     %s\n' "$(command -v stty 2>/dev/null || echo missing)"
  printf 'tput     %s\n' "$(command -v tput 2>/dev/null || echo missing)"
  printf 'config   %s\n' "$CONFIG"
  printf 'bin dir  %s\n' "$BIN_DIR"
  printf 'discover %s\n' "${AI_DISCOVER:-1}"
  local n
  for n in ${note[@]+"${note[@]}"}; do printf 'note     %s\n' "$n"; done
}

# Canonical absolute path, without GNU-only `readlink -f`.
abs_path() {
  local p=$1 n=0 tgt d b
  while [ -L "$p" ] && ((n < 40)); do
    tgt=$(readlink "$p") || break
    case $tgt in
      /*) p=$tgt ;;
      *) p=${p%/*}/$tgt ;;
    esac
    n=$((n + 1))
  done
  b=${p##*/}
  d=${p%/*}
  [ "$d" = "$p" ] && d=""
  if [ -d "$d" ]; then
    p=$(cd "$d" 2>/dev/null && pwd -P)
    [ -n "$p" ] || p=$d
    printf '%s/%s' "${p%/}" "$b"
  else
    printf '%s' "$p"
  fi
}

# Sets FOUND_PATH. Scans DIRS directly instead of `command -v`, because command
# substitution forks a process per lookup and that dominated startup on WSL.
find_cmd() {
  local d
  FOUND_PATH=""
  case $1 in
    */*)
      # config entries may name a full path
      if [ -f "$1" ] && [ -x "$1" ]; then FOUND_PATH=$1; return 0; fi
      return 1
      ;;
  esac
  for d in ${DIRS[@]+"${DIRS[@]}"}; do
    if [ -f "$d/$1" ] && [ -x "$d/$1" ]; then
      FOUND_PATH="$d/$1"
      return 0
    fi
  done
  return 1
}

# Every directory we look in: PATH, EXTRA_DIRS, then AI_EXTRA_DIRS.
# Paths are deduped with stat (-ef) so /bin and /usr/bin are only scanned once.
build_dirs() {
  local raw e dup
  local -a parts=() more=()
  IFS=':' read -ra parts <<< "$PATH"
  IFS=':' read -ra more <<< "${AI_EXTRA_DIRS:-}"
  for raw in ${parts[@]+"${parts[@]}"} "${EXTRA_DIRS[@]}" ${more[@]+"${more[@]}"}; do
    [ -n "$raw" ] || continue
    case "$raw" in
      /*) ;;
      *) continue ;;
    esac
    case "$raw" in /mnt/*) continue ;; esac
    [ -d "$raw" ] || continue
    dup=0
    for e in ${DIRS[@]+"${DIRS[@]}"}; do
      if [ "$e" -ef "$raw" ]; then dup=1; break; fi
    done
    [ "$dup" = 1 ] || DIRS+=("$raw")
  done
}

tools=()
all=()
DIRS=()
UNTRUSTED=()
declare -A have_key=() seen_key=() hidden_key=()

# Entries are keyed by the binary's base name, so a config entry that names a
# full path still dedupes with the registry and can still be hidden with
# `!command` written as a bare name.
add_entry() {
  local label=$1 cmd=$2 args=${3:-} hint=${4:-} path key
  [ -n "$cmd" ] || return 0
  key=${cmd##*/}
  [ -z "${hidden_key[$key]:-}" ] || return 0
  [ -z "${seen_key[$key]:-}" ] || return 0
  seen_key[$key]=1
  if find_cmd "$cmd"; then
    path=$FOUND_PATH
    have_key[$key]=1
    tools+=("$label|$cmd|$args|$hint|$path")
  else
    path=""
  fi
  all+=("$label|$cmd|$args|$hint|$path")
}

title_label() {
  local s=${1//[-_]/ }
  printf '%s' "${s^}"
}

# ~ instead of $HOME, as a literal prefix test - $HOME may contain glob chars.
# Sets S_PATH instead of printing, to keep the render loops fork-free.
short_path() {
  S_PATH=$1
  if [ "${S_PATH:0:${#HOME}}" = "$HOME" ]; then S_PATH="~${S_PATH:${#HOME}}"; fi
}

# -L matters: a plain stat on a symlink reports the link's own mode, which is
# always 777, and would flag every symlinked installer (npm globals, pyenv, ...).
file_mode() { stat -L -c '%a' "$1" 2>/dev/null || stat -L -f '%Lp' "$1" 2>/dev/null; }
file_uid() { stat -L -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null; }

# Writable by an account other than the owner: that account can replace the
# bytes between the moment we list a tool and the moment we exec it.
writable_by_others() {
  local m
  m=$(file_mode "$1") || return 1
  [[ $m =~ ^[0-7]{3,4}$ ]] || return 1
  (( (8#$m & 8#002) != 0 ))
}

# Returns 0 when the executable is safe to launch. Refuses a file or directory
# writable by another account, and a file owned by anyone but root or us.
# Group-writable is not checked: shared team installs are common and the group
# is usually our own.
trusted_file() {
  local f=$1 u
  [ -f "$f" ] || return 1
  [ "${AI_TRUST_INSECURE:-0}" = 1 ] && return 0
  command -v stat >/dev/null 2>&1 || return 0
  writable_by_others "$f" && return 1
  writable_by_others "${f%/*}" && return 1
  u=$(file_uid "$f") || return 0
  [ "$u" = 0 ] || [ "$u" = "$EUID" ] || return 1
  return 0
}

restore_tty() {
  [ -n "$SAVED_TTY" ] && stty "$SAVED_TTY" 2>/dev/null
  SAVED_TTY=""
}

launch() {
  local line="$1"; shift
  local -a extra=()
  local label cmd args hint path
  IFS='|' read -r label cmd args hint path <<< "$line"
  [ -n "$args" ] && IFS=' ' read -ra extra <<< "$args"
  path=${path:-$cmd}
  case $path in
    */*) ;;
    *) find_cmd "$path" && path=$FOUND_PATH ;;
  esac
  if ! trusted_file "$path"; then
    printf 'ai: refusing to launch %s\n' "$path" >&2
    printf '   it is world-writable, its directory is, or it is owned by another account\n' >&2
    printf '   set AI_TRUST_INSECURE=1 if you really mean to run it\n' >&2
    return 1
  fi
  restore_tty
  printf '\033[0m'
  printf 'launching %s (%s)\n' "$label" "$cmd" >&2
  # launch from the resolved path: it may live in a vendor dir that is not on
  # PATH. ${extra[@]+"..."} because args must not be glob-expanded.
  if [ ${#extra[@]} -gt 0 ]; then
    exec "$path" ${extra[@]+"${extra[@]}"} "$@"
  fi
  exec "$path" "$@"
}

cleanup() {
  local rc=$?
  trap - EXIT INT TERM
  restore_tty
  printf '\033[0m\033[?25h'
  exit "$rc"
}

show_all() {
  local only_missing=$1 line n_found=0 cmd label args hint path
  printf '%-20s %-14s %-8s %s\n' "LABEL" "COMMAND" "STATUS" "PATH / INSTALL"
  for line in ${tools[@]+"${tools[@]}"}; do
    IFS='|' read -r label cmd args hint path <<< "$line"
    short_path "$path"
    printf '%-20s %-14s %-8s %s\n' "$label" "${cmd##*/}" "found" "$S_PATH"
    n_found=$((n_found + 1))
  done
  for line in ${all[@]+"${all[@]}"}; do
    IFS='|' read -r label cmd args hint path <<< "$line"
    [ -z "$path" ] || continue
    [ "$only_missing" = 1 ] || printf '%-20s %-14s %-8s %s\n' "$label" "${cmd##*/}" "missing" "${hint:-see vendor docs}"
  done
  printf '\n%s found, %s registry entries missing.\n' "$n_found" "$((${#all[@]} - n_found))"
}

self_path() { abs_path "${BASH_SOURCE[0]}"; }

path_has() {
  local p=${1%/}
  case ":$PATH:" in *":$p:"*) return 0 ;; esac
  return 1
}

do_install() {
  local mode=symlink src target
  [ "${1:-}" = --copy ] && mode=copy
  src=$(self_path)
  check_deps
  mkdir -p "$BIN_DIR" || { printf 'ai: cannot create %s\n' "$BIN_DIR" >&2; exit 1; }
  target="$BIN_DIR/ai"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ "$(abs_path "$target")" = "$src" ]; then
      printf 'already installed: %s -> %s\n' "$target" "$src"
      return 0
    fi
    printf 'ai: %s already exists and is not this script. Not overwriting.\n' "$target" >&2
    printf '   remove it yourself, or install elsewhere: AI_BIN_DIR=/other/dir ai install\n' >&2
    return 1
  fi
  if [ "$mode" = copy ]; then
    cp "$src" "$target" || { printf 'ai: could not copy to %s\n' "$target" >&2; return 1; }
    chmod +x "$target" || { printf 'ai: copied, but chmod +x failed on %s\n' "$target" >&2; return 1; }
    printf 'installed (copy):    %s\n' "$target"
  else
    if ! ln -s "$src" "$target"; then
      printf 'ai: could not create %s (is %s writable?)\n' "$target" "$BIN_DIR" >&2
      return 1
    fi
    printf 'installed (symlink): %s -> %s\n' "$target" "$src"
  fi
  if path_has "$BIN_DIR"; then
    printf 'ready: run "ai" from any shell.\n'
  else
    printf '\nwarning: %s is not on PATH. Add to your shell rc:\n' "$BIN_DIR" >&2
    printf '  export PATH="%s:$PATH"\n' "$BIN_DIR" >&2
  fi
}

do_uninstall() {
  local src target real
  src=$(self_path)
  target="$BIN_DIR/ai"
  if [ ! -e "$target" ] && [ ! -L "$target" ]; then
    printf 'nothing to remove at %s\n' "$target"
    return 0
  fi
  real=$(abs_path "$target")
  if [ "$real" != "$src" ] && ! cmp -s "$target" "$src"; then
    printf 'ai: %s does not point at this script (%s).\n' "$target" "$src" >&2
    printf '   refusing to delete it; remove it manually if it is yours.\n' >&2
    return 1
  fi
  rm -f "$target" && printf 'removed %s\n' "$target"
}

# Subcommands that do not need detection at all.
case "${1:-}" in
  help | -h | --help) usage; exit 0 ;;
  --version | -v) printf 'ai %s\n' "$VERSION"; exit 0 ;;
  install) shift; do_install "$@"; exit $? ;;
  uninstall) do_uninstall; exit $? ;;
esac

check_deps
build_dirs

# 1. config: !command hides, Label|command|args adds
if [ -r "$CONFIG" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "${line// /}" ] || continue
    case "$line" in
      '#'*) continue ;;
      '!'*)
        hid=${line:1}
        hidden_key["${hid##*/}"]=1
        continue
        ;;
    esac
    IFS='|' read -r label cmd args <<< "$line"
    [ -n "${label:-}" ] && [ -n "${cmd:-}" ] || cmd=${label:-}
    [ -n "${label:-}" ] || label=$(title_label "${cmd##*/}")
    add_entry "$label" "$cmd" "${args:-}" "config:$CONFIG"
  done < "$CONFIG"
fi

# 2. curated registry
for entry in "${CANDIDATES[@]}"; do
  IFS='|' read -r label cmd args hint <<< "$entry"
  add_entry "$label" "$cmd" "$args" "$hint"
done

# 3. generic discovery: every executable in every search dir that is named like
# an agent. Runs entirely in builtins - spawning a process per file is far too
# slow on WSL and network mounts.
DISCOVERED=0
if [ "${AI_DISCOVER:-1}" != 0 ]; then
  for d in ${DIRS[@]+"${DIRS[@]}"}; do
    for f in "$d"/*; do
      [ -f "$f" ] && [ -x "$f" ] || continue
      base=${f##*/}
      [ -z "${seen_key[$base]:-}" ] || continue
      [ -z "${hidden_key[$base]:-}" ] || continue
      [[ "$base" == *@(${AGENT_TOKENS})* || "$base" == *agent* ]] || continue
      [[ "$base" =~ $AGENT_RE ]] || continue
      [[ "$base" =~ $DENY_RE ]] && continue
      [[ "$base" =~ $SYSTEM_AGENT_RE ]] && continue
      add_entry "$(title_label "$base")" "$base" "" "discovered in $d"
      [ -n "${have_key[$base]:-}" ] && DISCOVERED=$((DISCOVERED + 1))
    done
  done
fi

# These views work with an empty tool list, so keep them ahead of the
# "nothing installed" error - a fresh machine needs them most.
case "${1:-}" in
  -a | --all) show_all 0; exit 0 ;;
  --missing) show_all 1; exit 0 ;;
  doctor)
    check_deps verbose
    printf 'search dirs %s\n' "${#DIRS[@]}"
    printf 'detected    %s tools (%s by discovery)\n' "${#tools[@]}" "$DISCOVERED"
    if [ ${#tools[@]} -gt 0 ]; then
      for line in "${tools[@]}"; do
        IFS='|' read -r label cmd args hint path <<< "$line"
        trusted_file "$path" || UNTRUSTED+=("$path")
      done
      if [ ${#UNTRUSTED[@]} -gt 0 ]; then
        printf 'unsafe      %s tool(s) will be refused (world-writable, or owned by another account):\n' "${#UNTRUSTED[@]}"
        for line in "${UNTRUSTED[@]}"; do printf '          %s\n' "$line"; done
      fi
    fi
    echo
    show_all 0
    exit 0
    ;;
esac

if [ ${#tools[@]} -eq 0 ]; then
  echo "ai: no AI coding CLI detected." >&2
  echo "run 'ai -a' for the registry, or add one to $CONFIG" >&2
  exit 1
fi

# `ai <name> [args...]` launches directly, skipping the menu.
REQUESTED=""
if [ $# -gt 0 ]; then
  case "$1" in
    -l | --list) NONINTERACTIVE=1 ;;
    *) REQUESTED="$1" ;;
  esac
fi
if [ -n "$REQUESTED" ]; then
  for line in "${tools[@]}"; do
    IFS='|' read -r label cmd args hint path <<< "$line"
    lc=$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr -d ' -')
    if [ "$REQUESTED" = "$cmd" ] || [ "$REQUESTED" = "${cmd##*/}" ] || [ "$REQUESTED" = "$lc" ]; then
      shift
      launch "$line" "$@"
      exit 1
    fi
  done
  printf 'ai: "%s" is not a detected tool; showing the menu.\n\n' "$REQUESTED" >&2
fi

if [ ! -t 0 ] || [ ! -t 1 ] || [ "$NONINTERACTIVE" = 1 ]; then
  # A name that matched nothing must not look like success to a caller.
  [ -z "$REQUESTED" ] || exit 1
  for line in "${tools[@]}"; do
    IFS='|' read -r label cmd args hint path <<< "$line"
    printf '%s\t%s\n' "$cmd" "$label"
  done
  exit 0
fi

menu() {
  check_deps menu
  local n=${#tools[@]} sel=0 start=0 drawn=0 rows=0
  local cols i label cmd args hint path short row d lo hi more keys cmddisp
  cols=$(tput cols 2>/dev/null) || cols=80
  [ "$cols" -ge 50 ] || cols=50

  # The trap goes in before raw mode: a signal between the two would otherwise
  # leave the terminal in raw mode with nothing left to restore it.
  trap cleanup EXIT INT TERM
  if SAVED_TTY=$(stty -g 2>/dev/null); then
    stty raw -echo 2>/dev/null
  else
    SAVED_TTY=""
  fi

  while :; do
    rows=$(($(tput lines 2>/dev/null || echo 24) - 5))
    [ "$rows" -ge 3 ] || rows=3
    [ "$rows" -gt "$n" ] && rows=$n
    if ((sel < start)); then start=$sel; fi
    if ((sel >= start + rows)); then start=$((sel - rows + 1)); fi
    lo=$start; hi=$((start + rows - 1))

    local -a lines=()
    lines+=("$(printf '\033[1m  AI CLI launcher\033[0m')")
    for ((i = lo; i <= hi; i++)); do
      IFS='|' read -r label cmd args hint path <<< "${tools[i]}"
      short_path "$path"
      short=${S_PATH:0:cols - 40}
      cmddisp=${cmd##*/}
      if ((i == sel)); then
        row=$(printf '\033[36m  \u25b8 %-18.18s\033[0m\033[1m%-14.14s\033[0m  \033[2m%s\033[0m' "$label" "$cmddisp" "$short")
      else
        row=$(printf '    %-18.18s%-14.14s  \033[2m%s\033[0m' "$label" "$cmddisp" "$short")
      fi
      lines+=("$row")
    done
    if ((hi + 1 < n)); then
      more=$(printf '   \033[2m\u25be %s more\033[0m' $((n - hi - 1)))
    else
      more=""
    fi
    keys=$(printf '\033[2m  \u2191/\u2193 choose \u00b7 enter launch \u00b7 q quit\033[0m')
    lines+=("${keys}${more}")

    # erase the previous drawing, leaving the cursor on its top line
    printf '\r\033[2K'
    for ((i = 1; i < drawn; i++)); do printf '\033[1A\r\033[2K'; done
    for ((i = 0; i < ${#lines[@]}; i++)); do
      printf '%s' "${lines[i]}"
      if [ "$i" -lt $((${#lines[@]} - 1)) ]; then printf '\r\n'; fi
    done
    drawn=${#lines[@]}

    IFS= read -r -n1 key || { printf '\r\n'; exit 130; }
    case "$key" in
      '' | $'\r' | $'\n')
        printf '\r\n'
        launch "${tools[sel]}" || exit 1
        ;;
      q | Q) exit 0 ;;
      $'\x03') exit 130 ;;
      k) ((sel > 0)) && sel=$((sel - 1)) ;;
      j) ((sel < n - 1)) && sel=$((sel + 1)) ;;
      g) sel=0 ;;
      G) sel=$((n - 1)) ;;
      [[:digit:]])
        d=$((10#$key))
        ((d >= 1 && d <= n)) && sel=$((d - 1))
        ;;
      $'\x1b')
        IFS= read -r -n1 -t 1 next || continue
        [ "$next" = "[" ] || continue
        IFS= read -r -n1 -t 1 code || continue
        case "$code" in
          A) ((sel > 0)) && sel=$((sel - 1)) ;;
          B) ((sel < n - 1)) && sel=$((sel + 1)) ;;
          G | H) sel=0 ;;
          F) sel=$((n - 1)) ;;
        esac
        ;;
    esac
  done
}

menu
